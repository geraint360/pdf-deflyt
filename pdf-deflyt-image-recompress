#!/usr/bin/env python3
"""
pdf-deflyt-image-recompress
Helper script for pdf-deflyt to handle ICC profile images using ImageMagick

DEPENDENCIES:
  System: ImageMagick (brew install imagemagick)
  Python: PyMuPDF (provided by the installer or already available on PATH)

The script will use a prebuilt local virtual environment next to the helper
when present. It does not create or bootstrap that environment at runtime.

USAGE:
  pdf-deflyt-image-recompress [-v] [-q QUALITY] INPUT OUTPUT
  
This script is normally called by pdf-deflyt automatically when needed.
"""

import sys
import os
import subprocess
import tempfile
import shutil
from pathlib import Path

def check_imagemagick():
    """Check if ImageMagick is available (magick or convert)"""
    return shutil.which('magick') is not None or shutil.which('convert') is not None

SCRIPT_DIR = Path(__file__).parent.resolve()
# The venv next to the helper (installed copy), then the installed one in ~/bin (so a
# repo checkout works too); the first that can import PyMuPDF wins
VENV_DIRS = [SCRIPT_DIR / ".pdf-deflyt-venv", Path.home() / "bin" / ".pdf-deflyt-venv"]


def _venv_has_pymupdf():
    for venv in VENV_DIRS:
        for name in ("python3", "python", "python3.14", "python3.13"):
            candidate = venv / "bin" / name
            if not candidate.exists():
                continue
            try:
                subprocess.run(
                    [str(candidate), "-c", "import fitz"],
                    check=True,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                )
                return venv, candidate
            except (OSError, subprocess.CalledProcessError):
                continue
    return None, None


VENV_DIR, venv_python = _venv_has_pymupdf()
if venv_python is not None and Path(sys.prefix).resolve() != VENV_DIR.resolve():
    os.execv(str(venv_python), [str(venv_python), __file__] + sys.argv[1:])

try:
    import fitz
except ImportError:
    print(
        "ERROR: PyMuPDF is not available. Re-run the installer with "
        "./scripts/install-pdf-deflyt.sh to prepare ICC support, or provide a "
        "prebuilt .pdf-deflyt-venv / a system Python that can import fitz.",
        file=sys.stderr,
    )
    sys.exit(1)
import argparse

# Configuration constants
IMAGEMAGICK_TIMEOUT = 30  # seconds for ImageMagick conversion operations
PYMUPDF_GARBAGE_LEVEL = 4  # Level 4: aggressive garbage collection

def convert_image_with_imagemagick(input_bytes, quality=75, resize_percent=0):
    """Convert image to JPEG using ImageMagick (preserves ICC)

    Args:
        input_bytes: Image data bytes
        quality: JPEG quality (1-100)
        resize_percent: Resize percentage for downsampling (0=no resize, e.g., 70=resize to 70%)
    """
    with tempfile.NamedTemporaryFile(suffix='.png', delete=False) as tmp_in:
        tmp_in.write(input_bytes)
        tmp_in_path = tmp_in.name

    tmp_out_path = tmp_in_path.replace('.png', '.jpg')

    try:
        # Build resize argument if resize_percent is specified
        resize_args = []
        if resize_percent > 0 and resize_percent < 100:
            resize_args = ['-resize', f'{resize_percent}%']

        # Try different ImageMagick command variants
        commands = [
            ['magick', tmp_in_path] + resize_args + ['-quality', str(quality), tmp_out_path],  # IM7 Linux style
            ['magick', 'convert', tmp_in_path] + resize_args + ['-quality', str(quality), tmp_out_path],  # IM7 macOS style
            ['convert', tmp_in_path] + resize_args + ['-quality', str(quality), tmp_out_path]  # IM6 style
        ]

        for cmd in commands:
            if not shutil.which(cmd[0]):
                continue

            result = subprocess.run(cmd, capture_output=True, timeout=IMAGEMAGICK_TIMEOUT)

            if result.returncode == 0 and os.path.exists(tmp_out_path):
                with open(tmp_out_path, 'rb') as f:
                    jpeg_bytes = f.read()
                return jpeg_bytes

        return None

    finally:
        # Clean up temp files - failures are non-fatal, OS will clean up /tmp
        try:
            os.unlink(tmp_in_path)
            if os.path.exists(tmp_out_path):
                os.unlink(tmp_out_path)
        except (OSError, IOError):
            pass

def recompress_pdf_images(input_path, output_path, quality=75, verbose=False, color_dpi=0, gray_dpi=0):
    """Recompress images using ImageMagick for ICC safety

    Args:
        input_path: Input PDF path
        output_path: Output PDF path
        quality: JPEG quality (1-100)
        verbose: Enable verbose output
        color_dpi: Target DPI for color images (0=no downsampling)
        gray_dpi: Target DPI for grayscale images (0=no downsampling)
    """

    if not check_imagemagick():
        print("ERROR: ImageMagick not found. Install with: brew install imagemagick", file=sys.stderr)
        return 1

    try:
        doc = fitz.open(input_path)

        if verbose:
            print(f"Processing {len(doc)} pages...", file=sys.stderr)

        done_xrefs = set()  # images shared across pages are only recompressed once
        for page_num in range(len(doc)):
            page = doc[page_num]
            image_list = page.get_images(full=True)

            if verbose and image_list:
                print(f"  Page {page_num + 1}: {len(image_list)} images", file=sys.stderr)

            for img_index, img in enumerate(image_list):
                xref = img[0]
                smask_xref = img[1] if len(img) > 1 else 0  # Soft mask reference
                if xref in done_xrefs:
                    continue
                done_xrefs.add(xref)

                try:
                    # Skip images with soft masks (transparency) - PyMuPDF's insert_image()
                    # doesn't properly preserve transparency when re-inserting
                    if smask_xref > 0:
                        if verbose:
                            print(f"    Image {img_index + 1}: Skipping (has transparency/smask)", file=sys.stderr)
                        continue

                    # Get image placement to calculate actual DPI
                    img_rects = page.get_image_rects(xref)
                    if not img_rects:
                        if verbose:
                            print(f"    Image {img_index + 1}: WARNING - Could not find image position, skipping", file=sys.stderr)
                        continue

                    # Extract image
                    base_image = doc.extract_image(xref)
                    image_bytes = base_image["image"]
                    image_ext = base_image["ext"]
                    width = base_image["width"]
                    height = base_image["height"]
                    colorspace = base_image.get("colorspace", 3)  # Default to 3 (RGB/color)

                    # Calculate actual DPI from image dimensions and page placement
                    # Page coordinates are in points (72 points = 1 inch)
                    rect = img_rects[0]  # Use first placement
                    rendered_width_inches = rect.width / 72.0
                    rendered_height_inches = rect.height / 72.0
                    actual_dpi_x = width / rendered_width_inches if rendered_width_inches > 0 else 0
                    actual_dpi_y = height / rendered_height_inches if rendered_height_inches > 0 else 0
                    actual_dpi = (actual_dpi_x + actual_dpi_y) / 2  # Average

                    # Determine target DPI based on colorspace
                    # colorspace: 1=gray, 3=RGB, 4=CMYK
                    target_dpi = 0
                    if colorspace == 1 and gray_dpi > 0:
                        target_dpi = gray_dpi
                    elif colorspace in (3, 4) and color_dpi > 0:
                        target_dpi = color_dpi

                    # Calculate resize percentage (0 = no resize)
                    resize_percent = 0
                    if target_dpi > 0 and actual_dpi > target_dpi:
                        resize_percent = int((target_dpi / actual_dpi) * 100)

                    if verbose:
                        cs_name = "gray" if colorspace == 1 else "color"
                        dpi_info = f", {int(actual_dpi)} → {target_dpi} DPI ({resize_percent}%)" if resize_percent > 0 else f", {int(actual_dpi)} DPI"
                        if image_ext in ("jpeg", "jpg"):
                            print(f"    Image {img_index + 1} ({cs_name}): recompressing JPEG (Q{quality}{dpi_info})", file=sys.stderr)
                        else:
                            print(f"    Image {img_index + 1} ({cs_name}): converting {image_ext} to JPEG (Q{quality}{dpi_info})", file=sys.stderr)

                    # Convert using ImageMagick
                    new_image_bytes = convert_image_with_imagemagick(image_bytes, quality, resize_percent)
                    
                    if new_image_bytes is None:
                        if verbose:
                            print(f"      WARNING: ImageMagick conversion failed, skipping", file=sys.stderr)
                        continue
                    
                    # Only update if smaller
                    if len(new_image_bytes) >= len(image_bytes):
                        if verbose:
                            print(f"      Kept original (would be larger)", file=sys.stderr)
                        continue

                    if hasattr(page, "replace_image"):
                        # PyMuPDF >= 1.21: swap the image stream in place, keeping every
                        # placement (on all pages) exactly as it was
                        page.replace_image(xref, stream=new_image_bytes)
                    else:
                        # Older PyMuPDF: delete and re-insert at each placement on this page
                        page.delete_image(xref)
                        for rect in img_rects:
                            page.insert_image(rect, stream=new_image_bytes, keep_proportion=True)
                    
                    if verbose:
                        reduction = (1 - len(new_image_bytes)/len(image_bytes)) * 100
                        print(f"      Compressed: {len(image_bytes)} → {len(new_image_bytes)} bytes ({reduction:.1f}% smaller)", file=sys.stderr)
                    
                except Exception as e:
                    if verbose:
                        print(f"    WARNING: Failed to process image {img_index + 1}: {e}", file=sys.stderr)
                    continue

        # Save
        doc.save(output_path, garbage=PYMUPDF_GARBAGE_LEVEL, deflate=True, clean=True)
        doc.close()
        
        if verbose:
            print(f"Saved to: {output_path}", file=sys.stderr)
        
        return 0
        
    except Exception as e:
        print(f"ERROR: Failed to process PDF: {e}", file=sys.stderr)
        return 1

# ---------------------------------------------------------------------------
# Photo cap: downsample decorative photos (web-clip and article illustrations)
# without touching anything that carries text.
# ---------------------------------------------------------------------------

PHOTO_CAP_MAX_PAGE_FRACTION = 0.5   # an image covering more of its page is a scan or slide
PHOTO_CAP_MIN_PAGE_TEXT = 200       # the page's information must be in real (visible) text
PHOTO_CAP_MAX_WORDS = 3             # Vision reading more words than this means a text image
PHOTO_CAP_MIN_GAIN = 0.10           # skip images that would shrink by less than 10%


def _words(lines):
    """Comparable word set from Vision output (case-insensitive, 2+ alphanumerics)."""
    out = set()
    for line in lines:
        for w in line.split():
            w = "".join(ch for ch in w.lower() if ch.isalnum())
            if len(w) >= 2:
                out.add(w)
    return out


def _ocr(tool, paths):
    """Run pdf-deflyt-ocr over PATHS; return {path: [lines]} (missing on failure)."""
    if not paths:
        return {}
    import json
    r = subprocess.run([tool] + paths, capture_output=True, timeout=120 + 10 * len(paths))
    found = {}
    for line in r.stdout.decode(errors="replace").splitlines():
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        found[obj.get("file")] = obj.get("text") or []
    return found


def _page_text(page):
    """Character centres on PAGE, split into visible and invisible (OCR) text."""
    visible, invisible = [], []
    for span in page.get_texttrace():
        hidden = span.get("type") == 3 or span.get("opacity", 1) == 0
        for c in span["chars"]:
            r = fitz.Rect(c[3])
            centre = fitz.Point((r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2)
            (invisible if hidden else visible).append(centre)
    return visible, invisible


def _cs_text(doc, kind, val):
    """Colour space as PDF text, following an indirect reference."""
    if kind == "xref":
        try:
            return doc.xref_object(int(val.split()[0]), compressed=True)
        except (ValueError, IndexError, RuntimeError):
            return ""
    return val


def _icc_components(doc, text):
    """Component count of an [/ICCBased n 0 R] colour space, else None."""
    if not text.lstrip("[ ").startswith("/ICCBased"):
        return None
    try:
        ref = int(text.split("/ICCBased", 1)[1].split()[0])
    except (ValueError, IndexError):
        return None
    comps = doc.xref_get_key(ref, "N")[1]
    return int(comps) if comps.isdigit() else None


def _jpeg_colorspace(doc, xref, n):
    """Can this image's pixels (N channels after decoding) be stored as a JPEG?

    Returns (ok, replacement): replacement is the /ColorSpace value to write, or None to
    keep the existing one. DeviceGray/DeviceRGB and ICCBased spaces are kept as they are;
    an Indexed palette over DeviceRGB or an RGB ICC profile becomes that base space.
    Anything else (Lab, DeviceN, CMYK, Separation, ...) is left alone."""
    kind, val = doc.xref_get_key(xref, "ColorSpace")
    if kind == "name":
        return val == ("/DeviceGray" if n == 1 else "/DeviceRGB"), None
    text = _cs_text(doc, kind, val).strip()
    if _icc_components(doc, text) == n:
        return True, None
    if text.lstrip("[ ").startswith("/Indexed") and n == 3:
        rest = text.split("/Indexed", 1)[1].split()
        if rest and rest[0].startswith("/DeviceRGB"):
            return True, "/DeviceRGB"
        if len(rest) >= 3 and rest[1] == "0" and rest[2].startswith("R"):
            base = "%s 0 R" % rest[0]
            if _icc_components(doc, _cs_text(doc, "xref", base)) == 3:
                return True, base
    return False, None


def photo_cap(input_path, output_path, cap_ppi, quality, ocr_tool, verbose=False):
    """Downsample decorative photos to CAP_PPI at their drawn size.

    An image is capped only if every check passes: no transparency, not 1-bit or CMYK,
    no text (visible or invisible OCR) drawn over it, it covers less than half its page,
    the page carries real text, it is above the cap, and Vision reads at most a few words
    in it. If Vision read any words, the downsampled image must still yield all of them.
    Returns 0 if images were capped, 2 if there was nothing to cap, 1 on error.
    """
    import json
    if not check_imagemagick():
        print("ERROR: ImageMagick not found", file=sys.stderr)
        return 1
    if not (ocr_tool and os.access(ocr_tool, os.X_OK)):
        print("ERROR: pdf-deflyt-ocr not available", file=sys.stderr)
        return 1

    doc = fitz.open(input_path)
    work = tempfile.mkdtemp(prefix="pdf-deflyt-cap-")
    reasons = {}

    def skip(why):
        reasons[why] = reasons.get(why, 0) + 1

    try:
        text_cache = {}
        placements = {}
        for pno, page in enumerate(doc):
            for info in page.get_image_info(xrefs=True):
                if info.get("xref"):
                    placements.setdefault(info["xref"], []).append((pno, fitz.Rect(info["bbox"])))

        todo = []
        for xref, places in placements.items():
            if doc.xref_get_key(xref, "SMask")[0] != "null" or doc.xref_get_key(xref, "Mask")[0] != "null":
                skip("transparency")
                continue
            if doc.xref_get_key(xref, "ImageMask")[0] == "bool" or doc.xref_get_key(xref, "BitsPerComponent")[1] == "1":
                skip("1-bit")
                continue
            ok, drawn_w = True, 0.0
            for pno, rect in places:
                page = doc[pno]
                rect = rect & page.rect
                if rect.is_empty:
                    continue
                if rect.width * rect.height > PHOTO_CAP_MAX_PAGE_FRACTION * page.rect.width * page.rect.height:
                    ok = False; skip("covers most of the page"); break
                if pno not in text_cache:
                    text_cache[pno] = _page_text(page)
                visible, invisible = text_cache[pno]
                area = rect + (-1, -1, 1, 1)
                if any(area.contains(pt) for pt in visible) or any(area.contains(pt) for pt in invisible):
                    ok = False; skip("text drawn over it"); break
                if len(visible) < PHOTO_CAP_MIN_PAGE_TEXT:
                    ok = False; skip("page has little real text"); break
                drawn_w = max(drawn_w, rect.width)
            if not ok or drawn_w <= 0:
                continue
            try:
                pix = fitz.Pixmap(doc, xref)
            except Exception:
                skip("unreadable")
                continue
            cs_ok, cs_new = (False, None)
            if pix.colorspace is not None and pix.colorspace.n in (1, 3):
                cs_ok, cs_new = _jpeg_colorspace(doc, xref, pix.colorspace.n)
            if not cs_ok or doc.xref_get_key(xref, "Decode")[0] != "null":
                skip("unsupported colour space")
                continue
            if pix.alpha:
                pix = fitz.Pixmap(pix, 0)
            ppi = pix.width / (drawn_w / 72.0)
            target_w = int(round(drawn_w / 72.0 * cap_ppi))
            if ppi <= cap_ppi * 1.1 or target_w < 64:
                skip("already at or below the cap")
                continue
            png = os.path.join(work, "x%d.png" % xref)
            pix.save(png)
            todo.append({"xref": xref, "png": png, "w": pix.width, "h": pix.height, "n": pix.colorspace.n, "cs": cs_new,
                         "target_w": target_w, "ppi": ppi, "page": places[0][0]})

        before = _ocr(ocr_tool, [t["png"] for t in todo])
        verify = []
        for t in todo:
            if t["png"] not in before:
                skip("OCR failed")
                t["skip"] = True
                continue
            t["words"] = _words(before[t["png"]])
            if len(t["words"]) > PHOTO_CAP_MAX_WORDS:
                skip("contains text")
                t["skip"] = True
                continue
            target_h = max(1, int(round(t["h"] * t["target_w"] / t["w"])))
            jpg = os.path.join(work, "x%d.jpg" % t["xref"])
            # The PDF keeps the image's own /ColorSpace (ICC profile included), so the JPEG
            # carries only pixels, with the same channel count as before
            cmd = ["magick", t["png"], "-filter", "Lanczos",
                   "-resize", "%dx%d!" % (t["target_w"], target_h),
                   "-type", "Grayscale" if t["n"] == 1 else "TrueColor",
                   "-quality", str(quality), "-sampling-factor", "4:2:0", "-strip", jpg]
            t["target_h"] = target_h
            r = subprocess.run(cmd, capture_output=True, timeout=IMAGEMAGICK_TIMEOUT)
            if r.returncode != 0 or not os.path.exists(jpg):
                skip("ImageMagick failed")
                t["skip"] = True
                continue
            old_len = len(doc.xref_stream_raw(t["xref"]) or b"")
            if os.path.getsize(jpg) > old_len * (1 - PHOTO_CAP_MIN_GAIN):
                skip("too little gain")
                t["skip"] = True
                continue
            t["jpg"], t["old"] = jpg, old_len
            if t["words"]:
                verify.append(t)

        # Legibility: whatever Vision could read before must still be readable after
        after = _ocr(ocr_tool, [t["jpg"] for t in verify])
        for t in verify:
            if not t["words"] <= _words(after.get(t["jpg"], [])):
                skip("less legible after downsampling")
                t["skip"] = True

        capped, saved = 0, 0
        for t in todo:
            if t.get("skip") or "jpg" not in t:
                continue
            with open(t["jpg"], "rb") as fh:
                data = fh.read()
            # Rewrite the image object in place: placements, colour space and any other
            # keys stay as they were; only the pixels, size and filter change
            xref = t["xref"]
            doc.update_stream(xref, data, compress=False)
            doc.xref_set_key(xref, "Filter", "/DCTDecode")
            doc.xref_set_key(xref, "DecodeParms", "null")
            doc.xref_set_key(xref, "Width", str(t["target_w"]))
            doc.xref_set_key(xref, "Height", str(t["target_h"]))
            doc.xref_set_key(xref, "BitsPerComponent", "8")
            if t["cs"]:
                doc.xref_set_key(xref, "ColorSpace", t["cs"])
            capped += 1
            saved += t["old"] - len(data)
            if verbose:
                print("  capped image %d: %dx%d at %.0f ppi -> %d px wide (%d ppi), %d -> %d bytes"
                      % (t["xref"], t["w"], t["h"], t["ppi"], t["target_w"], cap_ppi, t["old"], len(data)),
                      file=sys.stderr)
        print(json.dumps({"capped": capped, "bytes_saved": saved, "skipped": reasons}, sort_keys=True))
        if not capped:
            return 2
        doc.save(output_path, garbage=3, deflate=True, use_objstms=1)
        return 0
    except Exception as e:
        print(f"ERROR: photo cap failed: {e}", file=sys.stderr)
        return 1
    finally:
        doc.close()
        shutil.rmtree(work, ignore_errors=True)


def main():
    parser = argparse.ArgumentParser(description='Recompress PDF images using ImageMagick')
    parser.add_argument('input', help='Input PDF file')
    parser.add_argument('output', help='Output PDF file')
    parser.add_argument('-q', '--quality', type=int, default=75, help='JPEG quality (1-100, default: 75)')
    parser.add_argument('--color-dpi', type=int, default=0, help='Target DPI for color images (0=no downsampling)')
    parser.add_argument('--gray-dpi', type=int, default=0, help='Target DPI for grayscale images (0=no downsampling)')
    parser.add_argument('-v', '--verbose', action='store_true', help='Verbose output')
    parser.add_argument('--photo-cap', type=int, default=0, metavar='PPI',
                        help='Only downsample decorative photos to PPI (see photo_cap)')
    parser.add_argument('--ocr', default='', help='Path to pdf-deflyt-ocr (required with --photo-cap)')

    args = parser.parse_args()

    if not Path(args.input).exists():
        print(f"ERROR: Input file not found: {args.input}", file=sys.stderr)
        return 1

    if args.photo_cap:
        return photo_cap(args.input, args.output, args.photo_cap, args.quality, args.ocr, args.verbose)

    return recompress_pdf_images(args.input, args.output, args.quality, args.verbose, args.color_dpi, args.gray_dpi)

if __name__ == '__main__':
    sys.exit(main())
