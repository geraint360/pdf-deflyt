page_count() {
  pdfinfo "$1" 2>/dev/null | awk '/^Pages:/{print $2; found=1} END{if(!found) print 0}'
}

have_magick() { command -v magick >/dev/null 2>&1; }

# Pages to render for the visual check: all of them for short documents, otherwise the
# first, the last and evenly spread pages in between.
sample_pages() {
  awk -v n="$1" -v k="$VISUAL_SAMPLE_PAGES" 'BEGIN{
    if (n <= k) { for (i = 1; i <= n; i++) printf "%s%d", (i > 1 ? "," : ""), i; exit }
    for (i = 0; i < k; i++) {
      p = 1 + int(i * (n - 1) / (k - 1) + 0.5)
      if (!(p in seen)) { seen[p] = 1; printf "%s%d", (c++ ? "," : ""), p }
    }
  }'
}

# Render sampled pages of both files at low resolution and compare them.
# Catches gross damage from lossy passes (inverted CMYK, missing or blank images,
# colour shifts) without being sensitive to normal JPEG/downsampling noise.
# Returns 0 when the candidate looks like the reference, or when no check is possible.
visual_check() {
  local ref="$1" cand="$2" pages="$3" scratch="$4"
  have_magick || return 0
  (( pages >= 1 )) || return 0
  mkdir -p "$scratch" 2>/dev/null || return 0
  local list p dist
  list="$(sample_pages "$pages")"
  limit mutool draw -q -r 24 -c rgb -o "$scratch/ref-%d.png" "$ref" "$list" >/dev/null 2>&1 || return 0
  if ! limit mutool draw -q -r 24 -c rgb -o "$scratch/cand-%d.png" "$cand" "$list" >/dev/null 2>&1; then
    log_debug "visual check: candidate failed to render"
    return 1
  fi
  for p in ${(s:,:)list}; do
    [[ -f "$scratch/ref-$p.png" ]] || continue
    [[ -f "$scratch/cand-$p.png" ]] || return 1
    dist="$(magick "$scratch/ref-$p.png" -resize '256x256!' \
                   \( "$scratch/cand-$p.png" -resize '256x256!' \) \
                   -metric RMSE -compare -format '%[distortion]' info: 2>/dev/null)" || return 0
    [[ "$dist" =~ '^[0-9.eE+-]+$' ]] || return 0
    log_debug "visual check: page $p RMSE=$dist (limit $VISUAL_RMSE_LIMIT)"
    if awk -v d="$dist" -v l="$VISUAL_RMSE_LIMIT" 'BEGIN{exit !(d > l)}'; then
      return 1
    fi
  done
  return 0
}

# The text layer (e.g. OCR from a scanner) must stay extractable: DEVONthink indexes it.
# Compares the words pdftotext finds; layout/spacing differences are ignored.
text_check() {
  local ref_txt="$1" cand="$2" cand_txt="$3"
  [[ -s "$ref_txt" ]] && LC_ALL=C grep -q '[[:alnum:]]' "$ref_txt" || return 0
  limit pdftotext -q -enc UTF-8 "$cand" "$cand_txt" >/dev/null 2>&1 || return 1
  LC_ALL=C awk -v min="$TEXT_MATCH_MIN" -F '[^[:alnum:]]+' '
    FNR == NR { for (i = 1; i <= NF; i++) if ($i != "") { ref[tolower($i)]++; total++ }; next }
    { for (i = 1; i <= NF; i++) { t = tolower($i); if (t != "" && ref[t] > 0) { ref[t]--; matched++ } } }
    END { if (total == 0) exit 0; exit !(matched / total >= min) }' "$ref_txt" "$cand_txt"
}

# Lossless structural passes; keeps whichever valid result is smallest.
finalize_candidate() {
  local in="$1" out="$2" src="$1" best="$1" best_sz cand sz
  best_sz=$(size_of "$in")
  local -a tries=()
  if pdfcpu_optimize "$in" "$out.p"; then
    tries+=("$out.p"); src="$out.p"
  fi
  limit mutool clean -z "$src" "$out.m" >/dev/null 2>&1 && tries+=("$out.m")
  # qpdf exits 3 for "succeeded with warnings"
  local qrc=0
  limit qpdf --object-streams=generate --compress-streams=y --recompress-flate \
       --compression-level=9 "$src" "$out.q" >/dev/null 2>&1 || qrc=$?
  (( qrc == 0 || qrc == 3 )) && [[ -s "$out.q" ]] && tries+=("$out.q")
  for cand in "${tries[@]}"; do
    [[ -s "$cand" ]] || continue
    sz=$(size_of "$cand")
    (( sz < best_sz )) || continue
    pdfinfo "$cand" >/dev/null 2>&1 || continue
    best="$cand"; best_sz=$sz
  done
  cp "$best" "$out"
  rm -f "$out.p" "$out.m" "$out.q" 2>/dev/null || true
}

# Sanity-check a candidate against the (decrypted) input it was derived from.
# Record why a candidate was rejected; the last reason is reported if nothing is valid
reject() { REJECT_WHY="$*"; log_verbose "candidate rejected: $*"; return 1; }

validate_candidate() {
  local ref="$1" cand="$2" ref_pages="$3" lossy="$4" scratch="$5" pages
  [[ -s "$cand" ]] || return 1
  pages=$(page_count "$cand")
  if [[ "$pages" != "$ref_pages" ]]; then
    reject "page count $pages != $ref_pages"; return 1
  fi
  if $VALIDATE; then
    # qpdf exits 3 for warnings-only; treat that as acceptable
    local qrc=0
    qpdf --check "$cand" >/dev/null 2>&1 || qrc=$?
    (( qrc == 0 || qrc == 3 )) || { reject "qpdf --check failed"; return 1; }
  fi
  if [[ -n "${REF_FP:-}" ]]; then
    local why
    if ! why="$(pdftool check "$REF_FP" "$cand" 2>&1)"; then
      reject "${why:-feature check failed}"; return 1
    fi
  fi
  if [[ -n "${REF_TXT:-}" ]] && ! text_check "$REF_TXT" "$cand" "$scratch.txt"; then
    reject "text layer no longer matches the original"; return 1
  fi
  if [[ "$lossy" == true ]] && ! visual_check "$ref" "$cand" "$ref_pages" "$scratch"; then
    reject "rendered pages differ too much from the original"; return 1
  fi
  return 0
}

# Write SRC to DEST atomically (staged in DEST's directory, then renamed).
# When DEST is the original itself (in-place), the original's permissions, extended
# attributes (Finder tags etc.) and timestamps are carried over; otherwise the new file
# gets default permissions and the original's timestamps.
install_output() {
  local src="$1" dest="$2" ref="$3" stage
  stage="$(mktemp "${dest:h}/.${dest:t}.pdf-deflyt.XXXXXX")" || return 1
  {
    if [[ "${dest:A}" == "${ref:A}" ]]; then
      cp -p "$ref" "$stage" && cat "$src" > "$stage"
    else
      cat "$src" > "$stage" && chmod "$(printf '%o' $(( 8#666 & ~8#$(umask) )))" "$stage"
    fi
  } && touch -r "$ref" "$stage" && mv -f "$stage" "$dest" && return 0
  rm -f "$stage" 2>/dev/null || true
  return 1
}

csv_field() {
  local v="$1"
  if [[ "$v" == *[\",$'\n']* ]]; then
    v="\"${v//\"/\"\"}\""
  fi
  print -rn -- "$v"
}

write_log_row() {
  [[ -n "$LOGFILE" ]] || return 0
  local in="$1" in_b="$2" out_b="$3" note="$4" out="$5" ratio
  ratio=$(awk -v a="$out_b" -v b="$in_b" 'BEGIN{printf "%.4f",(b>0)?a/b:1}')
  if [[ ! -s "$LOGFILE" ]]; then
    print -r -- "input,input_bytes,output_bytes,ratio,preset,status,output" >> "$LOGFILE" 2>/dev/null || true
  fi
  print -r -- "$(csv_field "$in"),$in_b,$out_b,$ratio,$PRESET,$note,$(csv_field "$out")" >> "$LOGFILE" 2>/dev/null || \
    log_warn "Could not write to log file: $LOGFILE"
}

# Record one file's outcome: ok | kept | skipped | failed
record_result() {
  local st="$1" in_b="${2:-0}" out_b="${3:-0}"
  if [[ -n "${PDF_DEFLYT_RESULTS:-}" ]]; then
    print -r -- "$st $in_b $out_b" >> "$PDF_DEFLYT_RESULTS" 2>/dev/null || true
  fi
  tally_result "$st" "$in_b" "$out_b"
}

# Plain assignments: ((X++)) returns status 1 when X was 0, which trips `set -e`.
tally_result() {
  local st="$1" in_b="${2:-0}" out_b="${3:-0}"
  STATS_TOTAL=$(( STATS_TOTAL + 1 ))
  case "$st" in
    ok|kept)
      STATS_PROCESSED=$(( STATS_PROCESSED + 1 ))
      STATS_BYTES_IN=$(( STATS_BYTES_IN + in_b ))
      STATS_BYTES_OUT=$(( STATS_BYTES_OUT + out_b ))
      ;;
    skipped) STATS_SKIPPED=$(( STATS_SKIPPED + 1 )) ;;
    *) STATS_FAILED=$(( STATS_FAILED + 1 )) ;;
  esac
  return 0
}

# Sets C_RES G_RES M_RES JPEGQ from the preset and image analysis.
compute_targets() {
  local pre="$1" no_images="$2"
  C_RES=200 G_RES=200 M_RES=900 JPEGQ=74
  case "$pre" in
    light)    C_RES=300; G_RES=300; M_RES=1200; JPEGQ=78 ;;
    extreme)  C_RES=144; G_RES=144; M_RES=600;  JPEGQ=68 ;;
    lossless) C_RES=0;   G_RES=0;   M_RES=0;    JPEGQ=0 ;;
    standard)
      # Smart detection: if no images, optimize for text-only
      if [[ "$no_images" == true ]]; then
        C_RES=0; G_RES=0; M_RES=0; JPEGQ=0
      else
        if (( C_CNT > 0 )); then C_RES=$(( ${C_MED%.*} >= 380 ? 220 : 200 )); fi
        if (( G_CNT > 0 )); then G_RES=$(( ${G_MED%.*} >= 380 ? 220 : 200 )); fi
        if (( M_CNT > 0 )); then M_RES=$(( ${M_MED%.*} >= 900 ? 900 : 600 )); fi
        if (( C_CNT + G_CNT > 0 )); then JPEGQ=$(( (${C_MED%.*} + ${G_MED%.*} >= 700) ? 68 : 72 )); fi
      fi
      ;;
  esac
  if [[ -n "$JPEGQ_OVERRIDE" && "$pre" != lossless ]]; then
    JPEGQ="$JPEGQ_OVERRIDE"
  fi
  if [[ -n "$DPI_OVERRIDE" && "$pre" != lossless ]]; then
    C_RES="$DPI_OVERRIDE"; G_RES="$DPI_OVERRIDE"
    (( JPEGQ > 0 )) || JPEGQ=74
  fi
  # Resolution for decorative photos (images that carry no text), in ppi at drawn size
  case "$pre" in
    light) PHOTO_PPI=144 ;;
    standard) PHOTO_PPI=96 ;;
    extreme) PHOTO_PPI=72 ;;
    *) PHOTO_PPI=0 ;;
  esac
  [[ -n "$DPI_OVERRIDE" && "$pre" != lossless ]] && PHOTO_PPI="$DPI_OVERRIDE"
  return 0
}

has_icc_images() {
  pdfimages -list "$1" 2>/dev/null | awk '
    BEGIN { color_col=0; found=0 }
    /^page[[:space:]]+num[[:space:]]+type/ {
      for (i=1; i<=NF; i++) if ($i == "color") { color_col=i; break }
      next
    }
    /^-+/ { next }
    { if (color_col > 0 && NF >= color_col && tolower($color_col) == "icc") { found=1; exit } }
    END { exit (found ? 0 : 1) }'
}

# Returns: 0 processed (or kept original), 1 skipped, 2 failed.
process_one() {
  emulate -L zsh
  setopt localtraps
  local _po_work="" _po_lock="" _po_dec=""
  _po_cleanup() {
    [[ -n "$_po_work" ]] && rm -rf "$_po_work" 2>/dev/null
    [[ -n "$_po_lock" ]] && rm -rf "$_po_lock" 2>/dev/null
    [[ -n "$_po_dec" ]] && rm -f "$_po_dec" 2>/dev/null
    return 0
  }
  trap '_po_cleanup; exit 130' INT TERM HUP
  local rc=0
  _process_one_inner "$@" || rc=$?
  _po_cleanup
  return $rc
}

_process_one_inner() {
  local IN="$1" OUT_REQ="${2-}"
  local orig="$IN" OUT

  # Locking: two runs must never write the same destination at once. Runs that only
  # read the same input (e.g. -o to different files) do not conflict.
  local lock_target
  if $INPLACE || [[ -z "$OUT_REQ" ]]; then
    lock_target="${orig:A}"
  else
    lock_target="${OUT_REQ:A}"
  fi
  if ! _po_lock="$(acquire_input_lock "$lock_target")"; then
    _po_lock=""
    log "SKIP (locked): ${lock_target##*/} is already being processed"
    record_result skipped
    return 1
  fi
  if [[ -n "${PDF_DEFLYT_TEST_LOCK_HOLD:-}" && "${PDF_DEFLYT_TEST_LOCK_HOLD:-0}" != 0 ]]; then
    sleep "${PDF_DEFLYT_TEST_LOCK_HOLD}"
  fi

  if $INPLACE; then
    OUT="$orig"
  elif [[ -n "$OUT_REQ" ]]; then
    OUT="$OUT_REQ"
  else
    OUT="$(unique_filename "${orig%.*}_compressed.pdf")"
  fi
  $DEBUG && printf 'DEBUG: IN="%s" OUT="%s" PRESET=%s\n' "$IN" "$OUT" "$PRESET" >&2

  # Encryption
  if [[ -n "$PASSWORD" ]]; then
    local tmpdir
    tmpdir="$(choose_temp_root)" || { log_error "Failed to find a writable temporary directory"; record_result failed; return 2; }
    _po_dec="$(mktemp_in "$tmpdir" "pdf-deflyt.dec.XXXXXXXX")" || _po_dec=""
    if [[ -z "$_po_dec" ]]; then
      log_error "Failed to create temporary file in $tmpdir"
      record_result failed
      return 2
    fi
    chmod 600 "$_po_dec" 2>/dev/null || true
    local qrc=0
    limit qpdf --password="$PASSWORD" --decrypt -- "$IN" "$_po_dec" >/dev/null 2>&1 || qrc=$?
    if (( qrc == 0 || qrc == 3 )) && [[ -s "$_po_dec" ]]; then
      IN="$_po_dec"
    else
      log "SKIP: $orig (encrypted: incorrect password)"
      record_result skipped
      return 1
    fi
  elif is_pdf_encrypted "$IN"; then
    log "SKIP: $orig (encrypted - use --password or --password-file to process)"
    record_result skipped
    return 1
  fi

  local ORIG_BYTES=$(size_of "$orig")
  local IN_PAGES=$(page_count "$IN")
  if ! [[ "$IN_PAGES" =~ ^[0-9]+$ ]] || (( IN_PAGES < 1 )); then
    log_error "Not a readable PDF (pdfinfo could not parse it): $orig"
    record_result failed "$ORIG_BYTES" "$ORIG_BYTES"
    write_log_row "$orig" "$ORIG_BYTES" "$ORIG_BYTES" "failed" ""
    return 2
  fi

  if ! preflight_paths "$orig" "$OUT_REQ" "$INPLACE"; then
    record_result failed
    return 2
  fi

  _po_work="$(choose_work_tmpdir)" || {
    _po_work=""
    log_error "Failed to create working temp directory (tried TMPDIR, /private/tmp, /tmp, /var/tmp, and ~/Library/Caches/pdf-deflyt)"
    record_result failed
    return 2
  }
  local W="$_po_work"

  # 0) Reference: features/metadata fingerprint, text layer, and signature check
  local REF_FP="" REF_TXT="" SIGNED=false NO_LOSSY=false HAS_FIELDS=false REJECT_WHY=""
  if [[ -n "$PYTHON" ]]; then
    if pdftool fingerprint "$IN" > "$W/ref.json" 2>/dev/null && [[ -s "$W/ref.json" ]]; then
      REF_FP="$W/ref.json"
      grep -q '"signed": true' "$REF_FP" && SIGNED=true
      grep -q '"fields": \[\]' "$REF_FP" || HAS_FIELDS=true
    else
      log_verbose "Could not fingerprint ${orig##*/}; only structural optimization will be used"
      NO_LOSSY=true
    fi
  else
    # Without Python: detect signatures and interactive features conservatively
    [[ "$(limit qpdf --qdf --object-streams=disable "$IN" - 2>/dev/null | LC_ALL=C grep -ac '/ByteRange')" -gt 0 ]] && SIGNED=true
    if ! pdfinfo "$IN" 2>/dev/null | grep -q '^Form:[[:space:]]*none' || \
       [[ "$(pdfdetach -list "$IN" 2>/dev/null | awk 'NR==1{print $1+0}')" -gt 0 ]]; then
      log_verbose "Forms/attachments present and python3 unavailable; only structural optimization will be used"
      NO_LOSSY=true
    fi
  fi
  if limit pdftotext -q -enc UTF-8 "$IN" "$W/ref.txt" >/dev/null 2>&1; then
    REF_TXT="$W/ref.txt"
  fi
  if $SIGNED; then
    log "NOTICE: ${orig##*/} is digitally signed; keeping it unchanged (any rewrite would invalidate the signature)"
  fi

  # 1) Structural optimization (lossless). Never accept a bigger or broken result.
  local base="$W/base.pdf" IN_BYTES=$(size_of "$IN") PDFCPU_MADE_BIGGER=false
  if pdfcpu_optimize "$IN" "$base" && [[ "$(page_count "$base")" == "$IN_PAGES" ]]; then
    if (( $(size_of "$base") > IN_BYTES )); then
      PDFCPU_MADE_BIGGER=true
      cp "$IN" "$base"
    fi
  else
    log_debug "pdfcpu optimize failed; continuing from the original bytes"
    cp "$IN" "$base"
  fi

  # 2) Image analysis + targets
  local C_CNT G_CNT M_CNT C_MED G_MED M_MED C_MIN G_MIN M_MIN C_MAX G_MAX M_MAX
  read -r C_CNT G_CNT M_CNT C_MED G_MED M_MED C_MIN G_MIN M_MIN C_MAX G_MAX M_MAX <<<"$(analyse_pdf "$base")"
  local NO_IMAGES=false; (( C_CNT + G_CNT + M_CNT == 0 )) && NO_IMAGES=true
  local C_RES G_RES M_RES JPEGQ PHOTO_PPI
  compute_targets "$PRESET" "$NO_IMAGES"

  local HAS_ICC=false
  ! $NO_IMAGES && has_icc_images "$base" && HAS_ICC=true

  if $DEBUG; then
    local EST_LOW EST_HIGH
    read -r EST_LOW EST_HIGH <<<"$(estimate_savings "$PRESET" "$NO_IMAGES" "$C_CNT" "$G_CNT" "$M_CNT" "$C_MED" "$G_MED" "$M_MED" "$C_RES" "$G_RES" "$M_RES" "$JPEGQ")"
    printf "  Images: C(cnt=%s med=%.0f min=%.0f max=%.0f) G(cnt=%s med=%.0f min=%.0f max=%.0f) M(cnt=%s med=%.0f min=%.0f max=%.0f)\n" \
      "$C_CNT" "$C_MED" "$C_MIN" "$C_MAX" "$G_CNT" "$G_MED" "$G_MIN" "$G_MAX" "$M_CNT" "$M_MED" "$M_MIN" "$M_MAX"
    printf "  ICC images: %s\n" "$HAS_ICC"
    printf "  Targets: C_RES=%s G_RES=%s M_RES=%s JPEGQ=%s\n" "$C_RES" "$G_RES" "$M_RES" "$JPEGQ"
    printf "  Est. savings: %s–%s%%\n" "$EST_LOW" "$EST_HIGH"
    pdfimages -list "$base" 2>/dev/null | tail -n +3 | head -10
    record_result skipped
    return 0
  fi

  # 3) Build candidates. Each lossy candidate is validated before it can win, and the
  #    smallest valid one is used, so trying more strategies can never make things worse.
  local -a cands=("$base")
  typeset -A cand_lossy
  cand_lossy[$base]=false
  if $SIGNED; then
    cands=()
  elif [[ "$PRESET" == lossless ]] || $NO_LOSSY; then
    :
  elif $NO_IMAGES; then
    if ! $PDFCPU_MADE_BIGGER && gs_text_only_pass "$base" "$W/text.pdf" "$DETERMINISTIC" "$MEMORY_LIMIT_BYTES"; then
      cands+=("$W/text.pdf"); cand_lossy[$W/text.pdf]=true
    fi
  else
    # Ghostscript flattens ICC colour and drops form fields, so documents with either
    # also get a candidate that recompresses the images in place.
    if $HAS_ICC || $HAS_FIELDS; then
      log_verbose "ICC profile images or form fields detected; also trying the ImageMagick helper"
      local icc_in="$W/icc-in.pdf"
      # Repair with qpdf first; the helper is sensitive to xref problems
      limit qpdf "$base" "$icc_in" >/dev/null 2>&1 || cp "$base" "$icc_in"
      if python_recompress_images "$icc_in" "$W/icc.pdf" "$JPEGQ" "$C_RES" "$G_RES" >/dev/null 2>&1 && [[ -s "$W/icc.pdf" ]]; then
        cands+=("$W/icc.pdf"); cand_lossy[$W/icc.pdf]=true
      else
        log_verbose "ICC helper unavailable or failed; using Ghostscript only (re-run ./scripts/install-pdf-deflyt.sh to prepare PyMuPDF)"
      fi
    fi
    if gs_pass "$base" "$W/gs.pdf" "$JPEGQ" "$DETERMINISTIC" "$C_RES" "$G_RES" "$M_RES" "$MEMORY_LIMIT_BYTES" && [[ -s "$W/gs.pdf" ]]; then
      cands+=("$W/gs.pdf"); cand_lossy[$W/gs.pdf]=true
    else
      log_warn "Ghostscript recompression failed for ${orig##*/}; using structural optimization only"
    fi
    # Decorative photos (web clips, articles): Ghostscript applies one rule to every
    # image, so photos that carry no text are capped separately. One pass (Vision OCR is
    # the slow part), on the smaller of the structural and Ghostscript results; documents
    # with form fields use the structural one, since Ghostscript drops their fields
    if [[ -n "$OCR_TOOL" ]] && (( PHOTO_PPI > 0 )); then
      local cap_src="$base"
      if [[ -s "$W/gs.pdf" ]] && ! $HAS_FIELDS && (( $(size_of "$W/gs.pdf") < $(size_of "$base") )); then
        cap_src="$W/gs.pdf"
      fi
      if photo_cap_pass "$cap_src" "$W/cap.pdf"; then
        cands+=("$W/cap.pdf"); cand_lossy[$W/cap.pdf]=true
      fi
    fi
  fi

  # 4) Finalize + validate each candidate, keep the smallest valid one
  local best="" best_sz=0 c fin sz k=0
  local src img_log
  for c in "${cands[@]}"; do
    k=$(( k + 1 ))
    fin="$W/fin-$k.pdf"
    src="$c"
    # Lossless image pass: Huffman-optimized JPEGs and JBIG2 (generic, pixel-exact) for
    # 1-bit scans. The helper verifies every JBIG2 image against the original pixels.
    if [[ -n "$PYTHON" ]] && { $HAVE_JPEGTRAN || $HAVE_JBIG2; }; then
      if img_log="$(pdftool images "$c" "$W/img-$k.pdf" "$W/imgw-$k" \
                     "$($HAVE_JPEGTRAN && echo 1 || echo 0)" "$($HAVE_JBIG2 && echo 1 || echo 0)" 2>/dev/null)" \
         && [[ -s "$W/img-$k.pdf" ]]; then
        src="$W/img-$k.pdf"
        log_debug "lossless image pass on ${c:t}: $img_log"
      fi
      rm -rf "$W/imgw-$k" 2>/dev/null || true
    fi
    finalize_candidate "$src" "$fin"
    # Rewrites (Ghostscript, pdfcpu) replace dates and XMP; put the original's back
    if [[ -n "$REF_FP" ]]; then
      if pdftool restore-meta "$IN" "$fin" "$W/meta-$k.pdf" "$W/metaw-$k" >/dev/null 2>&1 && [[ -s "$W/meta-$k.pdf" ]]; then
        mv -f "$W/meta-$k.pdf" "$fin"
      fi
      rm -rf "$W/metaw-$k" 2>/dev/null || true
    fi
    if ! validate_candidate "$IN" "$fin" "$IN_PAGES" "${cand_lossy[$c]}" "$W/vc-$k"; then
      log_verbose "Rejected candidate ${c:t} for ${orig##*/} (failed validation)"
      continue
    fi
    sz=$(size_of "$fin")
    log_debug "candidate ${c:t}: $sz bytes"
    if [[ -z "$best" ]] || (( sz < best_sz )); then
      best="$fin"; best_sz=$sz
    fi
  done

  local note="ok" OUT_BYTES SAVEPCT BEST_PCT="0" replace_ok=0
  if $SIGNED; then
    OUT_BYTES=$ORIG_BYTES
  elif [[ -z "$best" ]]; then
    log_error "No valid compressed result for ${orig##*/}; keeping original${REJECT_WHY:+ (last rejection: $REJECT_WHY)}"
    note="validation-failed"
    OUT_BYTES=$ORIG_BYTES
  else
    OUT_BYTES=$best_sz
    BEST_PCT=$(awk -v a="$best_sz" -v b="$ORIG_BYTES" 'BEGIN{printf "%.2f",(b>0)?(100*(1-a/b)):0}')
    replace_ok=$(awk -v a="$OUT_BYTES" -v b="$ORIG_BYTES" -v m="$MIN_GAIN" \
      'BEGIN{s=(b>0)?100*(1-a/b):0; print (a<b && s>=m)?1:0}')
  fi

  if (( replace_ok )); then
    if $INPLACE && $BACKUP; then
      if cp -p "$orig" "${orig}.bak" 2>/dev/null; then
        log_verbose "Created backup: ${orig##*/}.bak"
      else
        log_error "Failed to create backup ${orig}.bak; leaving original untouched"
        record_result failed "$ORIG_BYTES" "$ORIG_BYTES"
        return 2
      fi
    fi
    if ! install_output "$best" "$OUT" "$orig"; then
      log_error "Failed to write output: $OUT"
      record_result failed "$ORIG_BYTES" "$ORIG_BYTES"
      write_log_row "$orig" "$ORIG_BYTES" "$ORIG_BYTES" "failed" "$OUT"
      return 2
    fi
  else
    [[ "$note" == ok ]] && note="kept-original"
    OUT_BYTES=$ORIG_BYTES
    if [[ "${OUT:A}" != "${orig:A}" ]] && ! install_output "$orig" "$OUT" "$orig"; then
      log_error "Failed to write output: $OUT"
      record_result failed "$ORIG_BYTES" "$ORIG_BYTES"
      return 2
    fi
  fi
  SAVEPCT=$(awk -v a="$OUT_BYTES" -v b="$ORIG_BYTES" 'BEGIN{printf "%.2f",(b>0)?(100*(1-a/b)):0}')

  if $SIDECAR; then
    sha_sidecar pre "$orig" || true
    sha_sidecar post "$OUT" || true
  fi

  if [[ -n "$POST_HOOK" ]]; then
    local cmd=${POST_HOOK//\{\}/${(q)OUT}}
    if ! env IN="$orig" OUT="$OUT" ORIG_BYTES="$ORIG_BYTES" OUT_BYTES="$OUT_BYTES" \
             PRESET="$PRESET" SAVEPCT="$SAVEPCT" "${commands[zsh]:-zsh}" -lc -- "$cmd"; then
      log_warn "Post-hook command failed: $cmd"
    fi
  fi

  write_log_row "$orig" "$ORIG_BYTES" "$OUT_BYTES" "$note" "$OUT"
  if [[ "$note" == ok ]]; then
    record_result ok "$ORIG_BYTES" "$OUT_BYTES"
  else
    record_result kept "$ORIG_BYTES" "$OUT_BYTES"
  fi

  # For kept-original, show what the best attempt achieved so the reason is visible
  $QUIET || printf '→ %s  (%.1f%% smaller)  [%s]\n' "$OUT" "$([[ $note == ok ]] && echo "$SAVEPCT" || echo "$BEST_PCT")" "$note"
  return 0
}

run_wrapper() {
  emulate -L zsh
  local f="$1" out="${2-}"

  if [[ -z "$f" ]]; then
    log "SKIP (empty path)"
    record_result skipped
    return 1
  fi

  if [[ ! -r "$f" ]]; then
    log "SKIP (unreadable): $f"
    record_result skipped
    return 1
  fi

  if [[ "${DRYRUN:-false}" == true ]]; then
    local tmpdir tmp1
    tmpdir="$(choose_work_tmpdir)" || {
      log_error "Failed to create a temporary directory"
      return 2
    }
    tmp1="$tmpdir/dry.pdf"
    local ORIG_BYTES=$(size_of "$f")

    pdfcpu_optimize "$f" "$tmp1" || cp "$f" "$tmp1" || { echo "DRY: $f (unreadable)"; rm -rf "$tmpdir"; return 0; }

    local C_CNT G_CNT M_CNT C_MED G_MED M_MED C_MIN G_MIN M_MIN C_MAX G_MAX M_MAX
    read -r C_CNT G_CNT M_CNT C_MED G_MED M_MED C_MIN G_MIN M_MIN C_MAX G_MAX M_MAX <<<"$(analyse_pdf "$tmp1")"
    local NO_IMAGES=false; (( C_CNT + G_CNT + M_CNT == 0 )) && NO_IMAGES=true
    local C_RES G_RES M_RES JPEGQ PHOTO_PPI
    compute_targets "$PRESET" "$NO_IMAGES"

    local EST_LOW EST_HIGH
    read -r EST_LOW EST_HIGH <<<"$(estimate_savings "$PRESET" "$NO_IMAGES" "$C_CNT" "$G_CNT" "$M_CNT" \
                                    "$C_MED" "$G_MED" "$M_MED" "$C_RES" "$G_RES" "$M_RES" "$JPEGQ")"

    local est_low_bytes=$(awk -v o="$ORIG_BYTES" -v p="$EST_HIGH" 'BEGIN{print (o*(100-p)/100)}')
    local est_high_bytes=$(awk -v o="$ORIG_BYTES" -v p="$EST_LOW"  'BEGIN{print (o*(100-p)/100)}')

    printf 'DRY: %s  preset=%s  est_savings≈%s–%s%%  est_size≈%s–%s (from %s)\n' \
        "$f" "$PRESET" "$EST_LOW" "$EST_HIGH" \
        "$(fmt_bytes "$est_low_bytes")" "$(fmt_bytes "$est_high_bytes")" \
        "$(fmt_bytes "$ORIG_BYTES")"

    rm -rf "$tmpdir" >/dev/null 2>&1 || true
    return 0
  fi

  local rc=0
  process_one "$f" "$out" || rc=$?
  return $rc
}

# Optional tools
TIMEOUT_BIN=""
if command -v gtimeout >/dev/null 2>&1; then
  TIMEOUT_BIN="$(command -v gtimeout)"
elif timeout --version 2>/dev/null | grep -q 'GNU coreutils'; then
  TIMEOUT_BIN="$(command -v timeout)"
fi
PYTHON="$(find_python 2>/dev/null)" || PYTHON=""
HAVE_JPEGTRAN=false; command -v jpegtran >/dev/null 2>&1 && HAVE_JPEGTRAN=true
HAVE_JBIG2=false; command -v jbig2 >/dev/null 2>&1 && HAVE_JBIG2=true
OCR_TOOL=""; $PHOTO_CAP && OCR_TOOL="$(resolve_ocr_tool 2>/dev/null)" || OCR_TOOL=""

if $INTERNAL_ONE; then
  rc=0
  run_wrapper "${FILES[1]}" "" || rc=$?
  # Skips are not errors in a batch; only failures make the worker exit non-zero
  (( rc == 2 )) && exit 1
  exit 0
fi
if [[ -n "$OUT_SINGLE" ]]; then
  rc=0
  run_wrapper "${FILES[1]}" "$OUT_SINGLE" || rc=$?
  (( rc == 0 )) && exit 0
  exit 1
fi

total="${#FILES[@]}"
(( JOBS > total )) && JOBS=$total
STATS_START_TIME=$(date +%s)
STATS_TOTAL=0 STATS_PROCESSED=0 STATS_SKIPPED=0 STATS_FAILED=0 STATS_BYTES_IN=0 STATS_BYTES_OUT=0
batch_rc=0

if (( JOBS > 1 )); then
  # Workers re-run this script with the same options for one file each.
  typeset -a WORKER_OPTS
  WORKER_OPTS=(-p "$PRESET" --min-gain "$MIN_GAIN" --color "$($ENABLE_COLOR && echo always || echo never)")
  [[ -n "$JPEGQ_OVERRIDE" ]] && WORKER_OPTS+=(-q "$JPEGQ_OVERRIDE")
  [[ -n "$DPI_OVERRIDE" ]] && WORKER_OPTS+=(--dpi "$DPI_OVERRIDE")
  $PHOTO_CAP || WORKER_OPTS+=(--no-photo-cap)
  $INPLACE && WORKER_OPTS+=(--inplace)
  $BACKUP && WORKER_OPTS+=(--backup)
  $VALIDATE && WORKER_OPTS+=(--validate)
  $DRYRUN && WORKER_OPTS+=(--dry-run)
  $DEBUG && WORKER_OPTS+=(--debug)
  (( VERBOSE == 1 )) && WORKER_OPTS+=(--verbose)
  $QUIET && WORKER_OPTS+=(--quiet)
  $SIDECAR && WORKER_OPTS+=(--sidecar-sha256)
  [[ -n "$LOGFILE" ]] && WORKER_OPTS+=(--log "$LOGFILE")
  [[ -n "$MEMORY_LIMIT" ]] && WORKER_OPTS+=(--memory-limit "$MEMORY_LIMIT")
  WORKER_OPTS+=(--timeout "$STEP_TIMEOUT")
  [[ -n "$POST_HOOK" ]] && WORKER_OPTS+=(--post-hook "$POST_HOOK")
  if [[ -n "$PASSWORD_FILE" ]]; then
    WORKER_OPTS+=(--password-file "$PASSWORD_FILE")
  elif [[ -n "$PASSWORD" ]]; then
    WORKER_OPTS+=(--password "$PASSWORD")
  fi

  results_dir="$(choose_work_tmpdir)" || { log_error "Failed to create a temporary directory"; exit 1; }
  trap 'rm -rf "$results_dir" 2>/dev/null' EXIT
  export PDF_DEFLYT_RESULTS="$results_dir/results"
  : > "$PDF_DEFLYT_RESULTS"
  self="${0:A}"

  $QUIET || log "Processing $total files with $JOBS parallel workers..."
  if $PARALLEL_OK && command -v parallel >/dev/null 2>&1; then
    printf '%s\0' "${FILES[@]}" | \
      command parallel -0 -q -j "$JOBS" --no-notice --will-cite \
        "$self" "${WORKER_OPTS[@]}" --internal-one -- {} || batch_rc=1
  else
    printf '%s\0' "${FILES[@]}" | \
      xargs -0 -n 1 -P "$JOBS" "$self" "${WORKER_OPTS[@]}" --internal-one -- || batch_rc=1
  fi

  # Aggregate per-worker results
  while read -r st in_b out_b; do
    [[ -n "$st" ]] && tally_result "$st" "$in_b" "$out_b"
  done < "$PDF_DEFLYT_RESULTS"
else
  current=0
  for f in "${FILES[@]}"; do
    (( current = current + 1 ))
    if ! $QUIET && (( total > 1 )); then
      pct=$(awk -v c="$current" -v t="$total" 'BEGIN{printf "%.0f", (c/t)*100}')
      printf '[%3d%%] (%d/%d) %s\n' "$pct" "$current" "$total" "${f##*/}" >&2
    fi
    rc=0
    run_wrapper "$f" "" || rc=$?
    (( rc == 2 )) && batch_rc=1
  done
fi

if (( total > 1 )) && ! $QUIET && ! $DRYRUN && ! $DEBUG; then
  print_batch_summary
fi
(( STATS_FAILED > 0 )) && batch_rc=1
exit $batch_rc
